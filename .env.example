# ====================================================================
# Antigravity Environment Variables Configuration Example
# Copy this file to .env and fill in the required values.
# ====================================================================

# [Application Environment]
APP_NAME=AntigravityApplication
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key

# [Database Configuration]
DB_PATH=src/infrastructure/database/app.db
DB_JOURNAL_MODE=WAL

# [LLM / AI Provider API Keys (Optional)]
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# [Server & Network Configuration]
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
